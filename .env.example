# Emergency Ambulance Dispatch System - Environment Variables
FLASK_SECRET_KEY=eads-super-secret-key-change-in-production
FLASK_DEBUG=1

# Google Maps Platform API Key (Optional)
# If provided, enables Google Maps JavaScript API, Places API (Autocomplete), and Routes API.
# If omitted or left empty, the application automatically runs in Demo Mode with interactive Leaflet/OSM maps and simulated GPS coordinates.
GOOGLE_MAPS_API_KEY=YOUR_KEY_HERE

